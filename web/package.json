{
    "name": "@bwdesigngroup/neo4j-web",
    "version": "0.0.1",
    "description": "Neo4J Driver Web Components",
    "main": "dist/index.js",
    "scripts": {
        "build": "cross-env NODE_ENV=production webpack --mode production --devtool false",
        "dev": "cross-env NODE_ENV=development webpack --mode development --watch",
        "lint": "eslint \"src/**/*.{ts,tsx}\"",
        "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\"",
        "type-check": "tsc --noEmit",
        "clean": "rimraf build dist"
    },
    "dependencies": {
        "create-react-class": "^15.7.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-redux": "^9.1.2",
        "redux": "^5.0.1",
        "redux-thunk": "^3.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "@types/create-react-class": "^15.6.8",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@typescript-eslint/eslint-plugin": "^8.14.0",
        "@typescript-eslint/parser": "^8.14.0",
        "cross-env": "^7.0.3",
        "css-loader": "^7.1.2",
        "eslint": "^9.15.0",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^5.0.0",
        "globals": "^15.12.0",
        "mini-css-extract-plugin": "^2.9.2",
        "prettier": "^3.3.3",
        "rimraf": "^6.0.1",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.6.3",
        "webpack": "^5.96.1",
        "webpack-cli": "^5.1.4"
    },
    "overrides": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    }
}
